# The web app manifest must be served as a manifest, not as octet-stream: with
# X-Content-Type-Options: nosniff below, a wrong type can make a browser refuse
# the manifest and the install prompt never appears.
/manifest.webmanifest
  Content-Type: application/manifest+json

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
